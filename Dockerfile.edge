# Standalone baseline EDGE simulator. ARM64-compatible base; no cloud/web server.
FROM python:3.12-slim-bookworm
ENV PYTHONUNBUFFERED=1 OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2
WORKDIR /app
RUN pip install --no-cache-dir "numpy>=2,<3" "scipy>=1.12,<2" "pandas>=2,<3"
COPY swarm_core.py fleet_core.py model.py ./
COPY edge/ ./edge/
RUN useradd --uid 10001 --create-home edge && mkdir -p /state && chown edge:edge /state
USER edge
VOLUME ["/state"]
ENTRYPOINT ["python", "-m", "edge"]
CMD ["--help"]
