# Local Windows launcher reads .env. Docker/Amvera use service environment variables.
AGMEN_PROFILE=local
HOST=127.0.0.1
PORT=7860
# Absolute persistent path recommended; default is this project's data/ directory.
# AGMEN_DATA_DIR=C:/AGMEN/data
# Private server: set profile=private and a long random token via secret storage.
# AGMEN_API_TOKEN=
# External deployment: list real hostnames and HTTPS origins from your hosting account.
# AGMEN_ALLOWED_HOSTS=agmen.example.org
# AGMEN_ALLOWED_ORIGINS=https://agmen.example.org
AGMEN_MAX_RSS_MB=2048
OMP_NUM_THREADS=2
MKL_NUM_THREADS=2
OPENBLAS_NUM_THREADS=2
SWARM_ENABLE_REAL=0
